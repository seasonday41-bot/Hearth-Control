{
  "name": "hearth-control",
  "productName": "Hearth Control",
  "private": true,
  "version": "0.4.3",
  "type": "module",
  "description": "A local macOS control center for a desktop MCP workflow.",
  "author": "Hearth Control",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:metadata": "node scripts/generate-build-meta.cjs",
    "build": "npm run build:metadata && tsc -b && vite build",
    "preview": "vite preview",
    "start": "electron .",
    "mcp:stdio": "node mcp/stdio.mjs",
    "test:mcp": "node scripts/verify-mcp.mjs",
    "test:mcp:stdio": "node scripts/verify-stdio.mjs",
    "test:updater": "node scripts/test-updater.mjs",
    "test:safety": "node scripts/test-safety.mjs",
    "test:bridge": "node scripts/test-bridge.mjs",
    "test:antigravity": "node scripts/test-antigravity.mjs",
    "test:live-status": "node scripts/test-live-status.mjs",
    "test:goal-runner": "node scripts/test-goal-runner.mjs",
    "test:persistence": "node scripts/test-persistence.mjs",
    "test:jobs": "node scripts/test-job-runtime.mjs",
    "test:continuation": "node scripts/test-continuation-recovery.mjs",
    "test:local-provider": "node --test scripts/test-local-provider.mjs",
    "test:provider-selection": "node --test scripts/test-provider-selection.mjs",
    "test:local-chat": "node --test scripts/test-local-chat.mjs",
    "smoke:local-provider": "node scripts/smoke-local-provider.mjs",
    "dist:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --arm64",
    "package:update": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 && node scripts/generate-update-manifest.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "react": "latest",
    "react-dom": "latest",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.hearth.control",
    "productName": "Hearth Control",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "mcp/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        { "target": "dmg", "arch": ["arm64"] }
      ]
    },
    "dmg": {
      "title": "Hearth Control ${version}",
      "iconSize": 96,
      "contents": [
        { "x": 140, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    }
  }
}
