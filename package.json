{
  "name": "hearth-control",
  "productName": "Hearth Control",
  "private": true,
  "version": "0.4.25",
  "type": "module",
  "description": "A local macOS control center for a desktop MCP workflow.",
  "author": "Hearth Control",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && node scripts/restore-stable-build-meta.cjs && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:metadata": "node scripts/generate-build-meta.cjs",
    "restore:stable-meta": "node scripts/restore-stable-build-meta.cjs",
    "build": "npm run build:metadata && tsc -b && vite build",
    "preview": "vite preview",
    "start": "npm run restore:stable-meta && electron .",
    "mcp:stdio": "node mcp/stdio.mjs",
    "test:mcp": "node scripts/verify-mcp.mjs",
    "test:mcp:stdio": "node scripts/verify-stdio.mjs",
    "test:updater": "node scripts/test-updater.mjs",
    "test:local-update": "node --test scripts/test-local-update.mjs",
    "test:safety": "node scripts/test-safety.mjs",
    "test:jobs": "node scripts/test-job-runtime.mjs",
    "test:connections": "node --test scripts/test-connection-registry.mjs scripts/test-secure-credential-store.mjs scripts/test-connection-service.mjs scripts/test-connection-main-boundary.mjs",
    "test:github": "node --test scripts/test-github-client.mjs scripts/test-github-connections.mjs scripts/test-github-mcp-tools.mjs scripts/test-github-main-boundary.mjs scripts/test-github-http-transport.mjs",
    "test:vercel": "node --test scripts/test-vercel-client.mjs scripts/test-vercel-connections.mjs scripts/test-vercel-mcp-tools.mjs scripts/test-vercel-main-boundary.mjs scripts/test-vercel-http-transport.mjs",
    "dist:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --arm64",
    "package:update": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 && node scripts/generate-update-manifest.cjs",
    "set-version": "node scripts/release/set-version.cjs",
    "release:status": "node scripts/release/status.cjs",
    "release:prepare": "node scripts/release/prepare.cjs",
    "release:provenance": "node scripts/release/provenance.cjs",
    "test:version": "node --test --test-concurrency=1 scripts/test-release-version.mjs scripts/test-build-metadata.mjs",
    "test:coding-tools": "node --test scripts/test-core-coding-tools.mjs",
    "test:laya": "node --test scripts/test-laya-tools.mjs",
    "test:core-electron": "node --test scripts/test-core-electron-runtime.mjs",
    "test:updater-boundary": "node --test scripts/test-updater-runtime-preflight.mjs scripts/test-updater-startup-health.mjs scripts/test-update-ready-recovery.mjs scripts/test-remote-update-integration.mjs scripts/test-remote-stager-electron-asar.mjs scripts/test-remote-updater.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "react": "latest",
    "react-dom": "latest",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.hearth.control",
    "productName": "Hearth Control",
    "asar": true,
    "asarUnpack": [
      "mcp/**/*"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "mcp/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Hearth Control ${version}",
      "iconSize": 96,
      "contents": [
        {
          "x": 140,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
